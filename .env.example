# GEMINI_API_KEY: Required for Gemini AI API calls (unused by this static landing page).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_SITE_URL: Canonical production URL for SEO, sitemap.xml, and Open Graph tags.
NEXT_PUBLIC_SITE_URL="https://dumpandday.app"

# NEXT_PUBLIC_PLAY_STORE_URL: Leave empty to show the waitlist form; set to the Google Play URL to switch CTAs to download buttons.
NEXT_PUBLIC_PLAY_STORE_URL=""

# NEXT_PUBLIC_WAITLIST_ENDPOINT: Formspree-style endpoint URL that accepts a POST with an email field.
NEXT_PUBLIC_WAITLIST_ENDPOINT=""

# NEXT_PUBLIC_CONTACT_EMAIL: Public contact email used in the footer and privacy page.
NEXT_PUBLIC_CONTACT_EMAIL="hello@dumpandday.app"
